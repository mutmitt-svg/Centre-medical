# ---------------------------------------------------------------------------
# Variables d'environnement du frontend (Vite n'expose que les VITE_*)
# Copier ce fichier en .env.local puis renseigner les valeurs du projet.
# ---------------------------------------------------------------------------

# URL du projet Supabase — Tableau de bord > Project Settings > Data API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clé publique anon (publishable). Ne JAMAIS mettre ici la clé service_role :
# elle contourne la sécurité au niveau des lignes.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# Schéma métier exposé par l'API (doit être déclaré dans Data API > Exposed schemas)
VITE_SUPABASE_SCHEMA=cs

# Identité de la structure affichée dans l'interface
VITE_STRUCTURE_NOM=Centre de Santé Kamalondo
VITE_STRUCTURE_CODE=CS-KAM-001

# Devise d'affichage par défaut
VITE_DEVISE=CDF
